
<!--MAIN-->
    <main>
      <section class="carrousel-section">
        <div class="div-carrousel">
          <div class="void-carrousel" aria-roledescription="carousel">
            <button class="vc-arrow vc-prev" aria-label="Anterior">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="vc-viewport">
             <!--GRID -->
             <div class="grid-limited-edition">
              <h1><i class="fa-solid fa-hashtag"></i>DROP_01</h1>
              <p class="p1">Handmade by BLNK-V0ID</p>
              <div class="p2-container">
                <p class="p2">Only <span class="limited-units">
                  {{#if featuredProduct.stock}}{{featuredProduct.stock}}
                  {{else}}1
                  {{/if}}
                  </span>units</p>
              </div>
              <a href="/products" class="continue-shopping-btn">
                <i class="fa-solid fa-arrow-right"></i>
                  Buy Now
              </a>
              </div>
              <!--GRID -->
              <div class="vc-track">
                <div class="vc-slide is-active">
                  <img src="assets/imgs/img-final-3.jpg" alt="Custom sneaker artwork 1" />
                </div>
                <div class="vc-slide">
                  <img src="assets/imgs/img-final-2.jpg" alt="Custom sneaker artwork 2" />
                </div>
                <div class="vc-slide">
                  <img src="assets/imgs/img-final-1.jpg" alt="Custom sneaker artwork 3" />
                </div>
              </div>
            </div>
            <button class="vc-arrow vc-next" aria-label="Siguiente">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
            <div class="vc-dots" aria-label="Selector de diapositivas"></div>
          </div>
        </div>
      </section>
