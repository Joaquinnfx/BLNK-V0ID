
<!--MAIN-->
    <main>
      <section class="carrousel-section">
        <div class="div-carrousel">
          <div class="void-carrousel" aria-roledescription="carousel">
            <button class="vc-arrow vc-prev" aria-label="Anterior">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="vc-viewport">
             <!--GRID -->
             <div class="grid-limited-edition" data-aos="zoom-in" data-aos-duration="1500">
              <h1 id="home-title"><i class="fa-solid fa-hashtag"></i>First Drop</h1>
              <p class="p1">Handmade by BLNK-V0ID</p>
              <div class="p2-container">
                <p class="p2">Only <span class="limited-units">
                  {{#if featuredProduct.stock}}{{featuredProduct.stock}}
                  {{else}}1
                  {{/if}}
                  </span>units</p>
              </div>
              <a href="/products" class="continue-shopping-btn">
                <i class="fa-solid fa-arrow-right"></i>
                  Buy Now
              </a>
              </div>
              <!--GRID -->
              <div class="vc-track">
                <div class="vc-slide is-active">
                  <img src="/assets/imgs/foto-car-1.webp" alt="Custom sneaker artwork 1" />
                </div>
                <div class="vc-slide">
                  <img src="/assets/imgs/foto-car-2.webp" alt="Custom sneaker artwork 2" />
                </div>
                <div class="vc-slide">
                  <img src="/assets/imgs/foto-car-3.webp" alt="Custom sneaker artwork 3" />
                </div>
              </div>
            </div>
            <button class="vc-arrow vc-next" aria-label="Siguiente">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
            <div class="vc-dots" aria-label="Selector de diapositivas"></div>
          </div>
        </div>
      </section>
  <!-- BANNER -->
      <section class="banner-products">
        <div class="div-banner" data-aos="zoom-in" data-aos-duration="1500">
          <h2>Design to disrupt ~ Made to empower</h2>
          <p>Are you ready to disrupt?</p>
          <a href="/products" class="continue-shopping-btn">
            [ Explore Collection ]
          </a>
        </div>
      </section>
  <!-- SECTION DROPS -->
    <h2 class="section-title title-products" data-aos="zoom-in" data-aos-duration="1500"> Drop 1.1 </h2>
